---
import ProjectCard from "@components/ProjectCard.astro";
import { projectCards } from "@data/content";
---

<section id="work" class="projects">
  <div class="projects__inner">
    <header class="projects__header">
      <p class="projects__eyebrow">
        Selected work
      </p>
      <h2 class="projects__title">
        Things I've shipped.
      </h2>
    </header>

    <ul class="projects__grid">
      {
        projectCards.map((p) => (
          <li
            class={
              p.featured
                ? "projects__cell projects__cell--featured"
                : "projects__cell"
            }
          >
            <ProjectCard
              project={p}
              featured={p.featured}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style lang="scss">
  .projects {
    padding: var(--space-800)
      var(--shell-padding-x);
    background: var(
      --color-surface-muted
    );
  }

  .projects__inner {
    max-width: var(--shell-max-width);
    margin: 0 auto;
  }

  .projects__eyebrow {
    color: var(--color-text-subtle);
    font-size: var(--text-300);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: var(--space-300);
  }

  .projects__title {
    font-size: var(--text-800);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-600);
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(
      2,
      1fr
    );
    gap: var(--space-500);
    align-items: stretch;
  }

  .projects__cell {
    display: flex;
  }

  .projects__cell--featured {
    grid-column: 1 / -1;
  }

  @media (max-width: 720px) {
    .projects__grid {
      grid-template-columns: 1fr;
    }
    .projects__cell--featured {
      grid-column: auto;
    }
  }
</style>
