---
import {
  hero,
  site,
} from "@data/content";

const {
  eyebrow,
  headline,
  accentPhrase,
  bio,
} = hero;
const { contact } = site;

// Split the headline around the accent phrase so it can be color-highlighted.
const accentIndex = headline.indexOf(
  accentPhrase,
);
const before =
  accentIndex >= 0
    ? headline.slice(0, accentIndex)
    : headline;
const accent =
  accentIndex >= 0 ? accentPhrase : "";
const after =
  accentIndex >= 0
    ? headline.slice(
        accentIndex +
          accentPhrase.length,
      )
    : "";

const githubLabel =
  contact.github.replace(
    /^https?:\/\//,
    "",
  );
const linkedinLabel =
  contact.linkedin.replace(
    /^https?:\/\//,
    "",
  );
---

<section id="about" class="hero">
  <div class="hero__inner">
    <div class="hero__main">
      <p class="hero__eyebrow">
        {eyebrow}
      </p>
      <h1
        class="hero__headline"
        data-headline
      >
        {before}<span
          class="hero__accent"
          >{accent}</span
        >{after}
      </h1>
      <p class="hero__bio" data-bio>
        {bio}
      </p>
    </div>

    <aside
      id="stack"
      class="hero__meta"
    >
      <dl class="hero__meta-list">
        <div class="hero__meta-row">
          <dt>Location</dt>
          <dd>{contact.location}</dd>
        </div>
        <div class="hero__meta-row">
          <dt>Email</dt>
          <dd class="hero__meta-email">
            <a
              href={`mailto:${contact.email}`}
              >{contact.email}</a
            >
            <button
              type="button"
              class="hero__copy"
              data-copy-email={contact.email}
              aria-label="Copy email to clipboard"
            >
              <svg
                class="hero__copy-icon hero__copy-icon--copy"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect
                  x="9"
                  y="9"
                  width="13"
                  height="13"
                  rx="2"
                  ry="2"></rect>
                <path
                  d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                ></path>
              </svg>
              <svg
                class="hero__copy-icon hero__copy-icon--check"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline
                  points="20 6 9 17 4 12"
                ></polyline>
              </svg>
            </button>
          </dd>
        </div>
        <div class="hero__meta-row">
          <dt>GitHub</dt>
          <dd>
            <a
              href={contact.github}
              rel="noopener noreferrer"
              target="_blank"
              >{githubLabel}</a
            >
          </dd>
        </div>
        <div class="hero__meta-row">
          <dt>LinkedIn</dt>
          <dd>
            <a
              href={contact.linkedin}
              rel="noopener noreferrer"
              target="_blank"
              >{linkedinLabel}</a
            >
          </dd>
        </div>
      </dl>
    </aside>
  </div>

  <a
    class="hero__scroll"
    href="#work"
    aria-label="Scroll to projects"
  >
    <span class="hero__scroll-label"
      >Scroll</span
    >
    <span
      class="hero__scroll-chevron"
      aria-hidden="true"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline
          points="6 9 12 15 18 9"
        ></polyline>
      </svg>
    </span>
  </a>
</section>

<script>
  import {
    animate,
    stagger,
  } from "animejs";

  const headline =
    document.querySelector<HTMLElement>(
      "[data-headline]",
    );
  if (
    headline &&
    !window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches
  ) {
    const accentEl =
      headline.querySelector(
        ".hero__accent",
      );
    const accentWords = new Set(
      (accentEl?.textContent ?? "")
        .trim()
        .split(/\s+/),
    );
    const text = (
      headline.textContent ?? ""
    )
      .trim()
      .replace(/\s+/g, " ");
    headline.innerHTML = text
      .split(" ")
      .map((word) => {
        const m = word.match(
          /^([\p{L}\p{N}']+)([^\p{L}\p{N}']*)$/u,
        );
        const core = m ? m[1] : word;
        const tail = m ? m[2] : "";
        const isAccent =
          accentWords.has(core);
        const coreCls = isAccent
          ? "hero__word hero__word--accent"
          : "hero__word";
        const tailSpan = tail
          ? `<span class="hero__word">${tail}</span>`
          : "";
        return `<span class="${coreCls}">${core}</span>${tailSpan}`;
      })
      .join(" ");

    animate(".hero__word", {
      opacity: [0, 1],
      translateX: [16, 0],
      // scale: [0.92, 1],
      delay: stagger(60),
      duration: 700,
      ease: "cubicBezier(.22, 1, .36, 1)",
    });
  }

  const copyBtn =
    document.querySelector<HTMLButtonElement>(
      "[data-copy-email]",
    );
  if (copyBtn) {
    let resetTimer: number | undefined;
    copyBtn.addEventListener(
      "click",
      async () => {
        const email =
          copyBtn.dataset.copyEmail ??
          "";
        try {
          await navigator.clipboard.writeText(
            email,
          );
        } catch {
          return;
        }
        copyBtn.classList.add(
          "hero__copy--copied",
        );
        copyBtn.setAttribute(
          "aria-label",
          "Email copied",
        );
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(
          () => {
            copyBtn.classList.remove(
              "hero__copy--copied",
            );
            copyBtn.setAttribute(
              "aria-label",
              "Copy email to clipboard",
            );
          },
          1600,
        );
      },
    );
  }
</script>

<style lang="scss">
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    /* Fill the viewport below the sticky header. svh keeps mobile chrome from clipping. */
    min-height: calc(100svh - 4.5rem);
    padding: var(--space-800)
      var(--shell-padding-x)
      var(--space-900);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-700);
    width: 100%;
    max-width: var(--shell-max-width);
    margin: 0 auto;
  }

  .hero__eyebrow {
    color: var(--color-text-subtle);
    font-size: var(--text-300);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: var(--space-500);
  }

  .hero__headline {
    font-size: var(--text-display);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-text);
    max-width: 18ch;
  }

  .hero__headline :global(.hero__word) {
    display: inline-block;
    opacity: 0;
    will-change: opacity, transform;
  }

  .hero__accent,
  .hero__headline
    :global(.hero__word--accent) {
    color: var(--color-accent-strong);
  }

  .hero__bio {
    margin-top: var(--space-500);
    max-width: 52ch;
    color: var(--color-text-muted);
    font-size: var(--text-400);
    line-height: 1.65;
    min-height: 1.65em;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: var(--space-500);
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-200);
    color: var(--color-text-subtle);
    font-size: var(--text-300);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: color 0.2s ease;

    &:hover {
      color: var(--color-text);
    }
  }

  .hero__scroll-chevron {
    display: inline-flex;
    animation: hero-bounce 1.8s
      ease-in-out infinite;
  }

  @keyframes hero-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-chevron {
      animation: none;
    }
  }

  .hero__meta {
    align-self: start;
    padding-top: calc(
      var(--space-500) + 1.5rem
    );
  }

  .hero__meta-list {
    display: grid;
    gap: var(--space-300);
  }

  .hero__meta-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-300);
    font-size: var(--text-300);
  }

  .hero__meta-row dt {
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .hero__meta-row dd {
    color: var(--color-text);
    margin: 0;
    word-break: break-word;
  }

  .hero__meta-row a {
    color: inherit;
    border-bottom: 1px solid
      var(--color-border-strong);
    transition: border-color 0.2s ease;

    &:hover {
      border-color: var(
        --color-accent-strong
      );
    }
  }

  .hero__meta-email {
    display: inline-flex;
    align-items: center;
    gap: var(--space-300);
  }

  .hero__copy {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-subtle);
    transition:
      color 0.2s ease,
      background 0.2s ease;

    &:hover {
      color: var(--color-text);
      background: var(
        --color-surface-muted
      );
    }
  }

  .hero__copy-icon {
    position: absolute;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .hero__copy-icon--check {
    opacity: 0;
    transform: scale(0.6);
    color: var(--color-accent-strong);
  }

  .hero__copy--copied
    .hero__copy-icon--copy {
    opacity: 0;
    transform: scale(0.6);
  }

  .hero__copy--copied
    .hero__copy-icon--check {
    opacity: 1;
    transform: scale(1);
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-600);
    }

    .hero__meta {
      padding-top: 0;
    }
  }
</style>
