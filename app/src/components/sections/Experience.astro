---
import { timelineEntries } from "@data/content";

const current = timelineEntries[0];

// Floor keeps short stints legible (room for 3 lines of text); the rest
// scales with duration so the line visibly tracks how long each role ran.
function segmentPx(
  months: number,
): number {
  return Math.max(
    70,
    Math.min(220, months * 10),
  );
}
---

<section
  id="experience"
  class="timeline"
>
  <div
    class="timeline__track"
    data-timeline-track
  >
    <div class="timeline__pin">
      <div class="timeline__inner">
        <header
          class="timeline__header"
        >
          <p class="timeline__eyebrow">
            Experience
          </p>
          <h2 class="timeline__title">
            Where I've worked.
          </h2>
        </header>

        <div class="timeline__layout">
          <ol class="timeline__rail">
            <span
              class="timeline__marker"
              data-timeline-marker
              aria-hidden="true"></span>
            {
              timelineEntries.map(
                (entry, i) => (
                  <li class="timeline__item">
                    <button
                      type="button"
                      class={`timeline__row${i === 0 ? " timeline__row--active" : ""}`}
                      data-timeline-open={
                        entry.id
                      }
                      aria-current={
                        i === 0
                          ? "true"
                          : undefined
                      }
                    >
                      <span class="timeline__rail-line">
                        <span class="timeline__dot" />
                        {i <
                          timelineEntries.length -
                            1 && (
                          <span
                            class="timeline__segment"
                            style={`--seg: ${segmentPx(entry.durationMonths)};`}
                          >
                            {entry.durationMonths >
                              1 &&
                              Array.from(
                                {
                                  length:
                                    entry.durationMonths -
                                    1,
                                },
                              ).map(
                                (
                                  _,
                                  ti,
                                ) => (
                                  <span
                                    class="timeline__tick"
                                    style={`top: ${(((ti + 1) / entry.durationMonths) * 100).toFixed(2)}%;`}
                                  />
                                ),
                              )}
                          </span>
                        )}
                      </span>
                      <span class="timeline__row-body">
                        <span class="timeline__row-date">
                          {entry.range}
                        </span>
                        <span class="timeline__row-company">
                          {
                            entry.company
                          }
                        </span>
                        {entry.role && (
                          <span class="timeline__row-role">
                            {entry.role}
                          </span>
                        )}
                      </span>
                    </button>
                  </li>
                ),
              )
            }
          </ol>

          <aside
            class="timeline__detail"
            data-timeline-panel
            aria-live="polite"
          >
            <p
              class="timeline__detail-range"
              data-tl-range
            >
              {current.range}
            </p>
            <h3
              class="timeline__detail-company"
              data-tl-company
            >
              {current.company}
            </h3>
            <p
              class="timeline__detail-role"
              data-tl-role
            >
              {current.role}
            </p>
            <div
              class="timeline__detail-body"
              data-tl-body
            >
              {
                current.paragraphs.map(
                  (p) => <p>{p}</p>,
                )
              }
            </div>
            {
              current.highlights
                .length > 0 && (
                <div
                  class="timeline__detail-section"
                  data-tl-highlights-wrap
                >
                  <p class="timeline__detail-label">
                    Highlights
                  </p>
                  <ul
                    class="timeline__detail-highlights"
                    data-tl-highlights
                  >
                    {current.highlights.map(
                      (h) => (
                        <li>{h}</li>
                      ),
                    )}
                  </ul>
                </div>
              )
            }
            {
              current.stack.length >
                0 && (
                <ul
                  class="timeline__detail-stack"
                  data-tl-stack
                >
                  {current.stack.map(
                    (s) => (
                      <li>{s}</li>
                    ),
                  )}
                </ul>
              )
            }
            <a
              class="timeline__detail-link"
              data-tl-link
              href={current.href}
              style={current.href
                ? undefined
                : "display: none;"}
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit site →
            </a>
          </aside>
        </div>
      </div>
    </div>
  </div>

  <dialog
    class="tl-modal"
    data-timeline-modal
    aria-label="Role details"
  >
    <div class="tl-modal__card">
      <button
        type="button"
        class="tl-modal__close"
        data-timeline-close
        aria-label="Close"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line
            x1="18"
            y1="6"
            x2="6"
            y2="18"></line>
          <line
            x1="6"
            y1="6"
            x2="18"
            y2="18"></line>
        </svg>
      </button>
      <p
        class="tl-modal__range"
        data-tl-range
      >
      </p>
      <h3
        class="tl-modal__company"
        data-tl-company
      >
      </h3>
      <p
        class="tl-modal__role"
        data-tl-role
      >
      </p>
      <div
        class="tl-modal__body"
        data-tl-body
      >
      </div>
      <div
        class="tl-modal__section"
        data-tl-highlights-wrap
      >
        <p class="tl-modal__label">
          Highlights
        </p>
        <ul
          class="tl-modal__highlights"
          data-tl-highlights
        >
        </ul>
      </div>
      <ul
        class="tl-modal__stack"
        data-tl-stack
      >
      </ul>
      <a
        class="tl-modal__link"
        data-tl-link
        target="_blank"
        rel="noopener noreferrer"
      >
        Visit site →
      </a>
    </div>
  </dialog>

  <script
    type="application/json"
    id="timeline-data"
    is:inline
    set:html={JSON.stringify(
      timelineEntries,
    )}
  />
</section>

<script>
  type TimelineEntry = {
    id: string;
    company: string;
    role: string;
    range: string;
    year: string;
    durationMonths: number;
    isCurrent: boolean;
    paragraphs: string[];
    highlights: string[];
    stack: string[];
    href?: string;
  };

  const dataEl =
    document.getElementById(
      "timeline-data",
    );
  const entries: TimelineEntry[] =
    dataEl
      ? JSON.parse(
          dataEl.textContent ?? "[]",
        )
      : [];
  const byId = new Map(
    entries.map((e) => [e.id, e]),
  );

  const desktopQuery =
    window.matchMedia(
      "(min-width: 880px)",
    );

  // Fill any container (the sticky detail panel or the modal card) that
  // shares the same data-tl-* field markup.
  function fillFields(
    root: HTMLElement,
    entry: TimelineEntry,
  ) {
    const setText = (
      sel: string,
      value: string,
    ) => {
      const el =
        root.querySelector<HTMLElement>(
          sel,
        );
      if (el) el.textContent = value;
    };
    setText(
      "[data-tl-range]",
      entry.range,
    );
    setText(
      "[data-tl-company]",
      entry.company,
    );
    setText(
      "[data-tl-role]",
      entry.role,
    );

    const body =
      root.querySelector<HTMLElement>(
        "[data-tl-body]",
      );
    if (body) {
      body.innerHTML = "";
      for (const p of entry.paragraphs) {
        const para =
          document.createElement("p");
        para.textContent = p;
        body.appendChild(para);
      }
    }

    const hlWrap =
      root.querySelector<HTMLElement>(
        "[data-tl-highlights-wrap]",
      );
    const hl =
      root.querySelector<HTMLElement>(
        "[data-tl-highlights]",
      );
    if (hl && hlWrap) {
      hl.innerHTML = "";
      entry.highlights.forEach((h) => {
        const li =
          document.createElement("li");
        li.textContent = h;
        hl.appendChild(li);
      });
      hlWrap.style.display =
        entry.highlights.length > 0
          ? ""
          : "none";
    }

    const stack =
      root.querySelector<HTMLElement>(
        "[data-tl-stack]",
      );
    if (stack) {
      stack.innerHTML = "";
      entry.stack.forEach((s) => {
        const li =
          document.createElement("li");
        li.textContent = s;
        stack.appendChild(li);
      });
      stack.style.display =
        entry.stack.length > 0
          ? ""
          : "none";
    }

    const link =
      root.querySelector<HTMLAnchorElement>(
        "[data-tl-link]",
      );
    if (link) {
      if (entry.href) {
        link.href = entry.href;
        link.style.display = "";
      } else {
        link.removeAttribute("href");
        link.style.display = "none";
      }
    }
  }

  const panel =
    document.querySelector<HTMLElement>(
      "[data-timeline-panel]",
    );
  const modal =
    document.querySelector<HTMLDialogElement>(
      "[data-timeline-modal]",
    );
  const modalCard =
    modal?.querySelector<HTMLElement>(
      ".tl-modal__card",
    ) ?? modal;

  const rows =
    document.querySelectorAll<HTMLButtonElement>(
      "[data-timeline-open]",
    );

  let lastTrigger: HTMLElement | null =
    null;
  let activeId: string | null =
    rows[0]?.dataset.timelineOpen ??
    null;

  function selectRow(
    btn: HTMLButtonElement,
  ) {
    const id = btn.dataset.timelineOpen;
    const entry = id
      ? byId.get(id)
      : undefined;
    if (
      !entry ||
      !panel ||
      id === activeId
    )
      return;
    activeId = id ?? null;
    fillFields(panel, entry);
    rows.forEach((r) => {
      const on = r === btn;
      r.classList.toggle(
        "timeline__row--active",
        on,
      );
      if (on)
        r.setAttribute(
          "aria-current",
          "true",
        );
      else
        r.removeAttribute(
          "aria-current",
        );
    });
  }

  rows.forEach((btn) => {
    btn.addEventListener(
      "click",
      () => {
        const id =
          btn.dataset.timelineOpen;
        const entry = id
          ? byId.get(id)
          : undefined;
        if (!entry) return;

        if (
          desktopQuery.matches &&
          panel
        ) {
          selectRow(btn);
          // Move the page to the point in the track where the marker
          // lines up with this row, so click and scroll stay in sync.
          scrollToRow(btn);
          return;
        }

        if (modal && modalCard) {
          lastTrigger = btn;
          fillFields(
            modalCard as HTMLElement,
            entry,
          );
          modal.showModal();
        }
      },
    );
  });

  // Desktop: the section is pinned while the page scrolls through the
  // track, so nothing moves on screen except the marker travelling down
  // the rail — the row it reaches takes over the detail panel.
  const track =
    document.querySelector<HTMLElement>(
      "[data-timeline-track]",
    );
  const marker =
    document.querySelector<HTMLElement>(
      "[data-timeline-marker]",
    );
  const pin =
    document.querySelector<HTMLElement>(
      ".timeline__pin",
    );

  // Vertical centre of a row's dot, relative to the rail.
  function dotCentre(
    row: HTMLButtonElement,
  ): number {
    const dot =
      row.querySelector<HTMLElement>(
        ".timeline__dot",
      );
    if (!dot) return row.offsetTop;
    const railTop = row
      .closest<HTMLElement>(
        ".timeline__rail",
      )!
      .getBoundingClientRect().top;
    const box =
      dot.getBoundingClientRect();
    return (
      box.top - railTop + box.height / 2
    );
  }

  // Where the track starts scrolling and how far it runs. The pin sits
  // below the site header, so travel is measured against the pin's own
  // height, not the full viewport.
  function trackGeometry() {
    const trackTop =
      track!.getBoundingClientRect()
        .top + window.scrollY;
    const pinH =
      pin?.offsetHeight ??
      window.innerHeight;
    const headerH =
      window.innerHeight - pinH;
    return {
      start: trackTop - headerH,
      travel:
        track!.offsetHeight - pinH,
    };
  }

  // Scroll the page to the point where the marker meets this row.
  function scrollToRow(
    btn: HTMLButtonElement,
  ) {
    if (
      !desktopQuery.matches ||
      !track ||
      rows.length < 2
    )
      return;
    const first = dotCentre(rows[0]);
    const last = dotCentre(
      rows[rows.length - 1],
    );
    if (last === first) return;
    const target = dotCentre(btn);
    const ratio =
      (target - first) / (last - first);
    const { start, travel } =
      trackGeometry();
    // Snap the marker to the row right away; the scroll that follows
    // keeps it there rather than being what moves it.
    if (marker)
      marker.style.transform = `translateY(${target}px)`;
    window.scrollTo({
      top: start + ratio * travel,
      behavior: window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches
        ? "auto"
        : "smooth",
    });
  }

  let ticking = false;
  function syncToScroll() {
    ticking = false;
    if (
      !desktopQuery.matches ||
      !panel ||
      !track ||
      !marker ||
      rows.length === 0
    )
      return;

    const { start, travel } =
      trackGeometry();
    const passed =
      window.scrollY - start;
    const progress =
      travel > 0
        ? Math.min(
            1,
            Math.max(
              0,
              passed / travel,
            ),
          )
        : 0;

    const first = dotCentre(rows[0]);
    const last = dotCentre(
      rows[rows.length - 1],
    );
    const y =
      first + progress * (last - first);
    marker.style.transform = `translateY(${y}px)`;

    let nearest = rows[0];
    let nearestDist = Infinity;
    rows.forEach((r) => {
      const d = Math.abs(
        dotCentre(r) - y,
      );
      if (d < nearestDist) {
        nearestDist = d;
        nearest = r;
      }
    });
    selectRow(nearest);
  }

  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(
        syncToScroll,
      );
    },
    { passive: true },
  );
  window.addEventListener(
    "resize",
    syncToScroll,
  );
  syncToScroll();

  if (modal) {
    const close = () => {
      modal.close();
    };

    modal
      .querySelector(
        "[data-timeline-close]",
      )
      ?.addEventListener(
        "click",
        close,
      );

    // Click on the backdrop (outside the card) closes the dialog.
    modal.addEventListener(
      "click",
      (event) => {
        if (event.target === modal)
          close();
      },
    );

    modal.addEventListener(
      "close",
      () => {
        lastTrigger?.focus();
        lastTrigger = null;
      },
    );
  }
</script>

<style lang="scss">
  .timeline {
    background: var(
      --color-surface-muted
    );
  }

  .timeline__track {
    padding: var(--space-800) 0;
  }

  // Desktop pins the section: the page keeps scrolling through the track
  // while the panel stays put and only the marker moves.
  @media (min-width: 881px) {
    .timeline__track {
      height: calc(100vh + 1600px);
      padding: 0;
    }

    // Parks below the sticky site header rather than under it.
    .timeline__pin {
      position: sticky;
      top: var(--header-height);
      height: calc(
        100vh - var(--header-height)
      );
      display: flex;
      align-items: center;
      overflow: hidden;
    }
  }

  .timeline__inner {
    max-width: var(--shell-max-width);
    margin: 0 auto;
    padding: 0 var(--shell-padding-x);
  }

  .timeline__eyebrow {
    color: var(--color-text-subtle);
    font-size: var(--text-300);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: var(--space-300);
  }

  .timeline__title {
    font-size: var(--text-800);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .timeline__hint {
    margin-top: var(--space-300);
    color: var(--color-text-muted);
    font-size: var(--text-300);
  }

  // --- Layout: rail + sticky detail panel ------------------------------------
  .timeline__layout {
    margin-top: var(--space-700);
    display: grid;
    grid-template-columns:
      minmax(260px, 340px)
      1fr;
    gap: var(--space-700);
    align-items: start;
  }

  // Desktop: the panel is sized off the viewport, never off its contents, so
  // switching roles never resizes it — long entries scroll inside instead.
  @media (min-width: 881px) {
    .timeline__detail {
      height: calc(
        100vh - var(--header-height) -
          11rem
      );
    }
  }

  @media (max-width: 880px) {
    .timeline__layout {
      grid-template-columns: 1fr;
    }

    .timeline__detail {
      display: none;
    }
  }

  // --- Rail --------------------------------------------------------------------
  .timeline__rail {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .timeline__marker {
    position: absolute;
    top: 0;
    left: 0;
    width: 0.9rem;
    height: 0;
    display: none;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 2;
  }

  .timeline__marker::before {
    content: "";
    width: 1.15rem;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(
      --color-accent-strong
    );
  }

  @media (min-width: 881px) {
    .timeline__marker {
      display: flex;
    }
  }

  .timeline__row {
    display: flex;
    align-items: stretch;
    gap: var(--space-400);
    width: 100%;
    text-align: left;
    color: var(--color-text);
  }

  .timeline__rail-line {
    flex: none;
    width: 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .timeline__dot {
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    margin-top: 0.2rem;
    border-radius: var(--radius-pill);
    background: var(
      --color-text-subtle
    );
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .timeline__row--active
    .timeline__dot {
    background: var(
      --color-accent-strong
    );
    transform: scale(1.3);
  }

  // flex-grow keeps the line reaching the next dot when the text is taller
  // than the duration; min-height is what encodes the duration itself.
  .timeline__segment {
    position: relative;
    width: 2px;
    flex: 1;
    min-height: calc(var(--seg) * 1px);
    margin-top: var(--space-200);
    background: var(
      --color-border-strong
    );
  }

  // Pinned desktop has one viewport to work with, so the rail is compressed
  // proportionally — the relative lengths still read the same.
  @media (min-width: 881px) {
    .timeline__segment {
      min-height: calc(
        var(--seg) * 0.06vh
      );
    }
  }

  // One tick per month boundary, so the gaps between them read as a month.
  .timeline__tick {
    position: absolute;
    left: 50%;
    width: 7px;
    height: 1px;
    transform: translateX(-50%);
    background: var(
      --color-border-strong
    );
    opacity: 0.65;
  }

  .timeline__row-body {
    padding-bottom: var(--space-400);
  }

  .timeline__row-date {
    display: block;
    color: var(--color-text-subtle);
    font-size: var(--text-300);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .timeline__row-company {
    display: block;
    margin-top: var(--space-100);
    font-weight: 700;
    font-size: var(--text-400);
    transition: color 0.2s ease;
  }

  .timeline__row--active
    .timeline__row-company {
    color: var(--color-accent-strong);
  }

  .timeline__row-role {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-300);
  }

  // --- Detail panel (desktop) --------------------------------------------------
  .timeline__detail {
    padding: var(--space-700);
    border: 1px solid
      var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-hover);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  // --- Shared detail-content styles (panel + modal) -----------------------------
  .timeline__detail-range,
  .tl-modal__range {
    color: var(--color-text-subtle);
    font-size: var(--text-300);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .timeline__detail-company,
  .tl-modal__company {
    margin-top: var(--space-200);
    font-size: var(--text-700);
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .timeline__detail-role,
  .tl-modal__role {
    margin-top: var(--space-200);
    color: var(--color-accent-strong);
    font-weight: 600;
    font-size: var(--text-400);
  }

  .timeline__detail-body,
  .tl-modal__body {
    margin-top: var(--space-500);
    display: grid;
    gap: var(--space-400);
    color: var(--color-text-muted);
    font-size: var(--text-400);
    line-height: 1.65;
  }

  .timeline__detail-section,
  .tl-modal__section {
    margin-top: var(--space-600);
  }

  .timeline__detail-label,
  .tl-modal__label {
    color: var(--color-text-subtle);
    font-size: var(--text-300);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: var(--space-300);
  }

  .timeline__detail-highlights,
  .tl-modal__highlights {
    display: grid;
    gap: var(--space-300);
    color: var(--color-text-muted);
    font-size: var(--text-400);
    line-height: 1.55;
  }

  .timeline__detail-highlights li,
  .tl-modal__highlights li {
    position: relative;
    padding-left: var(--space-500);
  }

  .timeline__detail-highlights
    li::before,
  .tl-modal__highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-pill);
    background: var(
      --color-accent-strong
    );
  }

  .timeline__detail-stack,
  .tl-modal__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-300);
    margin-top: var(--space-600);
    color: var(--color-text-subtle);
    font-size: var(--text-300);
  }

  .timeline__detail-stack li,
  .tl-modal__stack li {
    padding: 0.25rem 0.6rem;
    border: 1px solid
      var(--color-border);
    border-radius: var(--radius-pill);
  }

  .timeline__detail-link,
  .tl-modal__link {
