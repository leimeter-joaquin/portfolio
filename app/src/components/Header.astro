---
import ThemeToggle from "@components/ThemeToggle.astro";
import { site } from "@data/content";
---

<header class="header">
  <div class="header__inner">
    <a
      class="header__brand"
      href="#top"
      aria-label="Joaquin Leimeter — home"
    >
      <span
        class="header__brand-mark"
        aria-hidden="true"></span>
      <span class="header__brand-name"
        >Joaquin Leimeter</span
      >
      <span class="header__brand-tag"
        >Full Stack Developer</span
      >
    </a>

    <div class="header__actions">
      <ThemeToggle />
      <a
        class="header__cta"
        href={site.cv.path}
        download
      >
        {site.cv.label}
      </a>
    </div>
  </div>
</header>

<style lang="scss">
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: var(--space-400)
      var(--shell-padding-x);
    background: rgba(
      var(--color-canvas-rgb),
      0.85
    );
    backdrop-filter: blur(14px);
    border-bottom: 1px solid
      var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-500);
    max-width: var(--shell-max-width);
    margin: 0 auto;
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-300);
    font-size: var(--text-400);
  }

  .header__brand-mark {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(
      --color-accent-strong
    );
  }

  .header__brand-name {
    font-weight: 700;
    color: var(--color-text);
  }

  .header__brand-tag {
    color: var(--color-text-subtle);
    font-size: var(--text-300);
  }

  .header__actions {
    display: inline-flex;
    align-items: center;
    gap: var(--space-300);
    margin-left: auto;
  }

  .header__cta {
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-pill);
    background: var(
      --color-accent-strong
    );
    color: #ffffff;
    font-weight: 600;
    font-size: var(--text-300);
    box-shadow: 0 8px 24px
      rgba(
        var(--color-accent-strong-rgb),
        0.35
      );
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;

    &:hover {
      transform: translateY(-1px);
      box-shadow: 0 12px 28px
        rgba(
          var(
            --color-accent-strong-rgb
          ),
          0.45
        );
    }
  }

  @media (max-width: 640px) {
    .header__inner {
      flex-wrap: wrap;
      gap: var(--space-300);
    }

    .header__brand-tag {
      display: none;
    }
  }
</style>
