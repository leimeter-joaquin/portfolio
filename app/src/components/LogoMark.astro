---
interface Props {
  size?: string;
  class?: string;
}

const {
  size = "2.25rem",
  class: className,
} = Astro.props;
---

{
  /*
  "JL" monogram from the Figma file, drawn as two stroked paths on a 128
  viewBox. The 8px stroke matches the bar width of the Figma mark.
*/
}
<span
  class:list={["logo-mark", className]}
  style={`--logo-mark-size: ${size};`}
>
  <svg
    viewBox="0 0 128 128"
    fill="none"
    role="img"
    aria-label="JL"
  >
    <path
      d="M 44 40 V 88 A 16 16 0 0 1 28 104"
    ></path>
    <path d="M 64 24 V 84 H 100"></path>
  </svg>
</span>

<style lang="scss">
  .logo-mark {
    display: inline-flex;
    flex: none;
    width: var(--logo-mark-size);
    height: var(--logo-mark-size);
    color: var(--color-accent-strong);

    svg {
      width: 100%;
      height: 100%;
    }

    path {
      fill: none;
      stroke: currentColor;
      stroke-width: 8;
      stroke-linecap: butt;
      stroke-linejoin: miter;
    }
  }
</style>
