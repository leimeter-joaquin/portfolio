---
import "@css/globals.scss";

interface Props {
  description?: string;
  title?: string;
}

const {
  description = "Joaquin Leimeter — full stack developer building from interface to infrastructure.",
  title = "Joaquin Leimeter — Full Stack Developer",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <meta
      name="description"
      content={description}
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <link
      rel="icon"
      href="/favicon.ico"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        const prefersDark =
          window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
        try {
          const stored =
            localStorage.getItem(
              "theme",
            );
          document.documentElement.dataset.theme =
            stored === "light" ||
            stored === "dark"
              ? stored
              : prefersDark
                ? "dark"
                : "light";
        } catch {
          document.documentElement.dataset.theme =
            prefersDark
              ? "dark"
              : "light";
        }
      })();
    </script>
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      />
    </noscript>
  </head>
  <body>
    <slot />

    <script>
      const html =
        document.documentElement;

      type ThemeName = "dark" | "light";

      function isTheme(
        value: string | undefined,
      ): value is ThemeName {
        return (
          value === "dark" ||
          value === "light"
        );
      }

      function persist(
        theme: ThemeName,
      ) {
        try {
          localStorage.setItem(
            "theme",
            theme,
          );
        } catch {
          /* ignore */
        }
      }

      function applyTheme(
        theme: ThemeName,
      ) {
        html.dataset.theme = theme;
        persist(theme);
      }

      function bind(
        button: HTMLButtonElement,
      ) {
        button.addEventListener(
          "click",
          () => {
            const current = isTheme(
              html.dataset.theme,
            )
              ? html.dataset.theme
              : "dark";
            const next: ThemeName =
              current === "light"
                ? "dark"
                : "light";

            const rect =
              button.getBoundingClientRect();
            const w = window.innerWidth;
            const h =
              window.innerHeight;
            // As percentages of the viewport, not pixels: the
            // view-transition snapshot box is not guaranteed to share the
            // viewport's coordinate space (device pixel ratio, scrollbars),
            // and a pixel offset that lands mid-screen there reads as a
            // wipe starting from the centre.
            const px =
              rect.left +
              rect.width / 2;
            const py =
              rect.top +
              rect.height / 2;
            const cx = (px / w) * 100;
            const cy = (py / h) * 100;
            // Radius as a percentage too. circle()'s percentage resolves
            // against hypot(w, h) / sqrt(2), so convert the distance to
            // the farthest corner through that same reference.
            const reach = Math.hypot(
              Math.max(px, w - px),
              Math.max(py, h - py),
            );
            const radius =
              (reach /
                (Math.hypot(w, h) /
                  Math.SQRT2)) *
              100;

            html.style.setProperty(
              "--ripple-x",
              `${cx}%`,
            );
            html.style.setProperty(
              "--ripple-y",
              `${cy}%`,
            );
            html.style.setProperty(
              "--ripple-r",
              `${radius}%`,
            );

            const supports =
              "startViewTransition" in
              document;
            const reduce =
              window.matchMedia(
                "(prefers-reduced-motion: reduce)",
              ).matches;

            if (!supports || reduce) {
              applyTheme(next);
              return;
            }

            // The keyframe in globals.scss reads the properties set
            // above and runs with the transition rather than a tick
            // after it, which keeps the wipe from stuttering on start.
            (
              document as Document & {
                startViewTransition: (
                  cb: () => void,
                ) => {
                  finished: Promise<void>;
                };
              }
            ).startViewTransition(
              () => {
                applyTheme(next);
              },
            );
          },
        );
      }

      function init() {
        const button =
          document.getElementById(
            "theme-toggle",
          ) as HTMLButtonElement | null;
        if (button) bind(button);
      }

      if (
        document.readyState ===
        "loading"
      ) {
        document.addEventListener(
          "DOMContentLoaded",
          init,
        );
      } else {
        init();
      }
    </script>
  </body>
</html>
